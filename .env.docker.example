# =============================================================================
# Sellf — environment for the root docker-compose.yml
# =============================================================================
# Copy to `.env` next to docker-compose.yml, fill in, then `docker compose up -d`.
#
# This file covers ONLY what the single-container Sellf compose needs.
# `admin-panel/.env.example` is the exhaustive reference (every optional
# integration, feature toggle, Stripe checkout tuning, etc.) — anything you
# add there works here too, since docker-compose.yml passes this file through
# via `env_file`.
#
# Supabase is NOT part of this compose file. Stand it up separately first:
# official self-hosted installer, the Coolify "Supabase" template, or
# Supabase Cloud. See docs-site: full-stack.md / deployment-coolify.md.
# =============================================================================


# --- Image / container ---
# SELLF_VERSION=2026.9.2          # image tag; see https://github.com/jurczykpawel/sellf/releases
# SELLF_PORT=3000                 # host port the container publishes
# SELLF_BIND=127.0.0.1            # host interface — keep on loopback behind a reverse proxy


# --- Supabase (the project you stood up separately) ---
SUPABASE_URL=https://your-supabase-project.example.com
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here   # full database access — never expose to a browser
# Only set this when SUPABASE_URL above is internal-only (e.g. a Docker
# network hostname behind Coolify) and a visitor's browser can't reach it.
# PUBLIC_SUPABASE_URL=https://your-public-supabase-domain


# --- Site URL (redirects, auth callbacks, magic links, email links) ---
SITE_URL=https://your-domain.example.com


# --- Auto-generated secrets — generate once, never rotate without reading the
#     matching note in admin-panel/.env.example (rotating breaks existing data) ---
CHECKOUT_BINDING_SECRET=   # openssl rand -base64 32
APP_ENCRYPTION_KEY=        # openssl rand -base64 32
LOGINWALL_SECRET=          # openssl rand -hex 32


# --- Stripe — choose ONE method ---
# METHOD 1 (env): fill in below. METHOD 2 (DB): leave blank and use the
# Settings → Payments wizard after your first login (keys stored encrypted).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Usually left unset — register the webhook from Settings → Payments instead;
# Sellf stores the signing secret encrypted in the DB.
# STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret_here


# --- Captcha (bot protection on signup / checkout) — pick one ---
# ALTCHA (self-hosted, zero external account):
# ALTCHA_HMAC_KEY=   # openssl rand -hex 32
# Cloudflare Turnstile (overrides ALTCHA when both keys are set):
# CLOUDFLARE_TURNSTILE_SITE_KEY=
# CLOUDFLARE_TURNSTILE_SECRET_KEY=


# --- Optional: OAuth social login (comma-separated, also enable in Supabase) ---
# OAUTH_PROVIDERS=google,github


# --- Optional: extra CORS/origin alias for embed checkout ---
# MAIN_DOMAIN=your-domain.example.com
