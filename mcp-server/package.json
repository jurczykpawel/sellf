{
  "name": "@sellf/mcp-server",
  "version": "1.0.0",
  "description": "MCP Server for Sellf - enables AI assistants to manage products, users, payments, and analytics",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsc",
    "start": "bun dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "bunx vitest run",
    "test:watch": "bunx vitest",
    "test:coverage": "bunx vitest run --coverage"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "sellf",
    "ai",
    "claude"
  ],
  "author": "Sellf",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.8",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "overrides": {
    "ip-address": "^10.7.2",
    "nanoid": "^3.3.19",
    "qs": "^6.16.0",
    "ajv": "^8.20.0",
    "fast-uri": "^3.1.8",
    "@hono/node-server": "^1.19.17",
    "hono": "^4.13.11",
    "path-to-regexp": "^8.4.2",
    "body-parser": "^2.3.0",
    "postcss": "^8.5.28"
  }
}
