{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "number",
      "const": 1
    },
    "surface": {
      "type": "string",
      "const": "storefront"
    },
    "shell": {
      "type": "string",
      "const": "store/1"
    },
    "sections": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "hero-product/1"
              },
              "variant": {
                "type": "string",
                "enum": [
                  "split-process",
                  "simple"
                ]
              },
              "product": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "string",
                    "enum": [
                      "heroProduct",
                      "closingProduct"
                    ]
                  }
                },
                "required": [
                  "setting"
                ],
                "additionalProperties": false
              },
              "content": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "home.hero"
                    ]
                  }
                },
                "required": [
                  "slot"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "variant",
              "product",
              "content"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "task-nav/1"
              },
              "categories": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "string",
                    "const": "taskCategories"
                  }
                },
                "required": [
                  "setting"
                ],
                "additionalProperties": false
              },
              "content": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "home.tasks",
                      "home.starts"
                    ]
                  }
                },
                "required": [
                  "slot"
                ],
                "additionalProperties": false
              },
              "target": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              }
            },
            "required": [
              "id",
              "type",
              "categories",
              "content",
              "target"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "product-list/1"
              },
              "variant": {
                "type": "string",
                "enum": [
                  "detail-cards",
                  "compact"
                ]
              },
              "products": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "string",
                    "const": "starterProducts"
                  }
                },
                "required": [
                  "setting"
                ],
                "additionalProperties": false
              },
              "content": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "home.tasks",
                      "home.starts"
                    ]
                  }
                },
                "required": [
                  "slot"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "variant",
              "products",
              "content"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "catalogue/1"
              },
              "variant": {
                "type": "string",
                "enum": [
                  "detail-cards",
                  "default-groups"
                ]
              },
              "source": {
                "type": "string",
                "const": "listed-products"
              },
              "filters": {
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "category",
                    "price-kind",
                    "format"
                  ]
                },
                "uniqueItems": true
              },
              "pageSize": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 9
                  },
                  {
                    "type": "number",
                    "const": 12
                  },
                  {
                    "type": "number",
                    "const": 24
                  }
                ]
              },
              "density": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "string",
                    "const": "density"
                  }
                },
                "required": [
                  "setting"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "variant",
              "source",
              "filters",
              "pageSize",
              "density"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "faq/1"
              },
              "content": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "home.faq"
                    ]
                  }
                },
                "required": [
                  "slot"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "type",
              "content"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "type": {
                "type": "string",
                "const": "product-cta/1"
              },
              "product": {
                "type": "object",
                "properties": {
                  "setting": {
                    "type": "string",
                    "enum": [
                      "heroProduct",
                      "closingProduct"
                    ]
                  }
                },
                "required": [
                  "setting"
                ],
                "additionalProperties": false
              },
              "content": {
                "type": "object",
                "properties": {
                  "slot": {
                    "type": "string",
                    "enum": [
                      "home.closing"
                    ]
                  }
                },
                "required": [
                  "slot"
                ],
                "additionalProperties": false
              },
              "action": {
                "type": "string",
                "enum": [
                  "details",
                  "buy"
                ]
              }
            },
            "required": [
              "id",
              "type",
              "product",
              "content",
              "action"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
